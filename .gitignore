# Unity regenerates these directories. Keep Assets (including .meta), Packages,
# ProjectSettings, native plugins and OBJ models under version control.
/DragonBoatVR/[Ll]ibrary/
/DragonBoatVR/[Tt]emp/
/DragonBoatVR/[Oo]bj/
/DragonBoatVR/[Ll]ogs/
/DragonBoatVR/[Uu]ser[Ss]ettings/
/DragonBoatVR/MemoryCaptures/
/DragonBoatVR/Recordings/
/DragonBoatVR/Build/
/DragonBoatVR/Builds/
.unity-execution.lock

# Built Players, previous deliveries and large runtime evidence stay local.
/Builds/
/_archive_*/
/_local/
/firmware/paddle/build/
/firmware/paddle/managed_components/
/tools/adc_runtime_checks/
/tools/build_results/
/tools/check_recordings/
/tools/check_results/
/tools/closed_loop_checks/
/tools/desktop_input_checks/
/tools/paddle_demo/
/tools/runtime_checks/
/tools/targeted_checks/
/tools/visual_upgrade*/
/tools/water_previews/
/tools/wood_contact_checks/
/tools/tendon_report.txt

# Stable CAD inputs now live in hardware/paddle/cad. Keep only the scratch
# directory marker; investigations, recordings and session state stay local.
/tmp/*
!/tmp/.gitkeep

# Local assistant state and conversation exports are not project source.
/.workbuddy/
/.codex/
/.claude/
/.vscode/
/.idea/
.vs/
/资料汇总/对话完整导出/
/资料汇总/对话上传的文件/

# Generated files and editor/CAD lock files.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.log
*.tmp
*.bak
~$*
.DS_Store
Thumbs.db
*.csproj
*.sln
*.suo
*.user

# Local credentials and Unity activation files.
.env
.env.*
!.env.example
!.env.sample
*.ulf
*.alf
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa
id_ed25519
